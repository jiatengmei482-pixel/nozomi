{
  "name": "nozomi-platform",
  "private": true,
  "description": "多租户用车报价与服务平台（接送机 / 点对点 / 包车）",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch --import ./scripts/load-env.mjs apps/api/src/server.ts",
    "db:migrate": "node --env-file-if-exists=.env apps/api/src/db/migrate-cli.ts",
    "admin:create": "node --env-file-if-exists=.env apps/api/src/cli/admin-create.ts",
    "admin:reset-password": "node --env-file-if-exists=.env apps/api/src/cli/admin-reset-password.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\"",
    "test:integration": "node --env-file-if-exists=.env --test \"apps/*/src/**/*.itest.ts\"",
    "check": "pnpm typecheck && pnpm test && pnpm test:integration && pnpm roadmap:check",
    "config:check": "node packages/config/src/cli.ts",
    "roadmap:check": "node scripts/check-roadmap.mjs",
    "progress:build": "node scripts/build-progress.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  }
}
