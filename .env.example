# 复制为 .env 后填写（.env 已被 .gitignore 忽略，绝不提交）。
# 每一项去哪里申请、在各环境填在哪里，见 docs/secrets.md。
# 检查是否填好：pnpm config:check

# ---- 运行环境 ----
# local | ci | staging | production
APP_ENV=local
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
# 服务前面有几层自己的反向代理（Nginx / Caddy 等）。本地直连填 0。
# 服务器上不用填：部署脚本按入口模式自动决定（standalone 是 1，behind-proxy 是 2，见 ADR 0007）。
# 填错的后果：填小了，审计日志里的来源地址是代理的地址；填大了，来源地址可以被请求头伪造。
TRUST_PROXY_HOPS=0

# ---- 数据库（本地用 docker compose up -d 启动）----
# 两个账号（docs/adr/0010-database-roles.md）。下面是本地开发库的公开默认值，不是密钥。
# 迁移账号：表的所有者，只有 pnpm db:migrate、pnpm db:provision 用它。
DATABASE_MIGRATION_URL=postgres://nozomi:nozomi@localhost:5432/nozomi
# 应用账号：权限最小，服务进程（pnpm dev）、管理员命令、集成测试里的应用代码用它。
# 第一次先运行 pnpm db:provision，它会按这里的账号名和密码把账号建好；这里不能填迁移账号（服务会拒绝启动）。
DATABASE_URL=postgres://nozomi_api:nozomi_api@localhost:5432/nozomi

# ---- 登录签名密钥：本地随便生成一串 ≥32 字符；正式环境 ≥64 字符 ----
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=

# ---- Stripe（非 production 环境只能填 sk_test_ / pk_test_；三项要么都填、要么都不填）----
# 只有 production 必须填；其他环境不填也能启动，/health 和 pnpm config:check 里显示「未配置」。
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- 谷歌地图（需要启用 Routes API；只有 production 必须填）----
GOOGLE_MAPS_API_KEY=

# ---- 地图底图（栅格瓦片；不是密钥，会下发给浏览器。不填 = 没有底图，区域页面仍然可用）----
# 测试环境可以用 OpenStreetMap 的官方瓦片（不要密钥；使用政策见 docs/adr/0015）：
#   MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#   MAP_TILE_ATTRIBUTION=© OpenStreetMap 贡献者|https://www.openstreetmap.org/copyright
MAP_TILE_URL_TEMPLATE=
MAP_TILE_ATTRIBUTION=

# ---- 汇率（免费源，无需密钥）----
FX_SOURCE_URL=https://open.er-api.com/v6/latest/USD
FX_BUFFER_PERCENT=1.5
